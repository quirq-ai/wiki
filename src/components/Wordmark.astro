---
interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
---

<a
  class:list={['wordmark', { 'wordmark-small': small }]}
  href="/"
  aria-label="Quirq Wiki main page"
>
  <svg class="wiki-globe" viewBox="0 0 68 68" aria-hidden="true">
    <defs>
      <radialGradient
        id={small ? 'wiki:globe-small' : 'wiki:globe'}
        cx="34%"
        cy="26%"
        r="75%"
      >
        <stop stop-color="#fff" />
        <stop offset=".7" stop-color="#e3e6e9" />
        <stop offset="1" stop-color="#aeb4bb" />
      </radialGradient>
    </defs>
    <circle
      cx="33"
      cy="33"
      r="29"
      fill={`url(#${small ? 'wiki:globe-small' : 'wiki:globe'})`}
      stroke="#a2a9b1"
      stroke-width=".7"
    />
    <g fill="none" stroke="#969ea7" stroke-width=".65">
      <path d="M7 22h11v-4h5v4h15v-4h5v4h15M5 37h12v5h5v-5h17v5h5v-5h17M12 50h14v-4h5v4h22M23 7v14l-4 4 4 4v9M42 7v14l4 4-4 4v9M17 38v12l5 7M44 38v12l-4 10M31 48v14" />
    </g>
    <g fill="#4b5159" font-family="Georgia, serif" text-anchor="middle">
      <text x="30" y="18" font-size="12">
        Q
      </text>
      <text x="13" y="34" font-size="11">
        λ
      </text>
      <text x="32" y="37" font-size="18">
        q
      </text>
      <text x="52" y="34" font-size="12">
        あ
      </text>
      <text x="31" y="58" font-size="12">
        W
      </text>
    </g>
  </svg>
  <span class="wordmark-text">
    <span class="brand-title">Quirq Wiki</span>
    <span class="brand-tagline">The open knowledge base</span>
  </span>
</a>
