---
interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
---

<a
  class:list={['wordmark', { 'wordmark-small': small }]}
  href="/"
  aria-label="Quirq Wiki main page"
>
  <!-- The favicon's grid globe with a "q" (public/favicon.svg), at header size. -->
  <svg class="wiki-globe" viewBox="0 0 64 64" aria-hidden="true">
    <circle cx="32" cy="30" r="23" fill="#f0f2f4" stroke="#72777d" />
    <path
      d="M10 22h44M9 36h46M18 12c-8 16-8 24 0 37M46 12c8 16 8 24 0 37M32 7v46"
      fill="none"
      stroke="#a2a9b1"
    />
    <text
      x="32"
      y="44"
      text-anchor="middle"
      font-family="Georgia, serif"
      font-size="39"
      fill="#202122"
    >
      q
    </text>
  </svg>
  <span class="wordmark-text">
    <span class="brand-title">Quirq Wiki</span>
    <span class="brand-tagline">Self evolving knowledge base</span>
  </span>
</a>
