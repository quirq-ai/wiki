---
import WikiLayout from '../layouts/WikiLayout.astro';
import Icon from '../components/Icon.astro';
import { dayBefore, getSizes, repoChange, totalsChange } from '../lib/sizes';
import { getWiki } from '../lib/wiki';
import { formatBytes } from '../lib/presentation';
const [sizes, wiki] = await Promise.all([getSizes(), getWiki()]);
const { latest, previous } = sizes;
const pages = new Map(wiki.repos.map((repo) => [repo.name, repo.href]));
const before = new Map(previous?.repos.map((row) => [row.repo, row]) ?? []);
const rows = [...(latest?.repos ?? [])].sort(
  (a, b) => (b.bytes ?? -1) - (a.bytes ?? -1) || a.repo.localeCompare(b.repo),
);
const history = [...sizes.snapshots]
  .reverse()
  .slice(0, 90)
  .map((snapshot) => ({
    snapshot,
    change: totalsChange(
      snapshot,
      dayBefore(sizes.snapshots, snapshot),
      'bytes',
    ),
  }));
const number = (value: number | null) =>
  value === null ? 'unknown' : value.toLocaleString('en-GB');
const bytes = (value: number | null) =>
  value === null ? 'unknown' : formatBytes(value);
// "—" means no figure to compare; a measured change of nothing reads "0".
const signed = (value: number | null, format: (n: number) => string) =>
  value === null
    ? '—'
    : value === 0
      ? '0'
      : `${value > 0 ? '+' : '−'}${format(Math.abs(value))}`;
const when = latest
  ? new Date(latest.takenAt).toLocaleString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'UTC',
    })
  : null;
const filesChange = totalsChange(latest, previous, 'files');
const bytesChange = totalsChange(latest, previous, 'bytes');
---

<WikiLayout
  title="Repository sizes"
  active="sizes"
  description="Files and size of every public quirq-ai repository and the organization as a whole, recorded daily."
  markdownPath="/sizes.md"
  headings={[
    { id: 'by-repository', text: 'By repository' },
    { id: 'history', text: 'History' },
  ]}
>
  <p class="page-introduction">
    How many files each public quirq-ai repository holds and how large they are,
    with one total for the organization, recorded every day.
  </p>
  <div class="information-note">
    <Icon name="clock" size={20} />
    <p>
      {when ? (
        <>
          Last measured on <strong>{when} UTC</strong>.
        </>
      ) : (
        'No sizes have been recorded yet; the first daily run fills this page.'
      )}{' '}
      Files and size count what is in each repository's default branch today.
      “On GitHub” is GitHub's own figure, which includes the full history. Files
      are Git blobs: symlinks count as files sized by their target path, Git LFS
      files count at pointer size, and submodules are left out. The total
      includes forks, archived repositories and this wiki. Private repositories
      are not included. Changes compare with the day before and show “—” when
      either day could not be measured in full.{' '}
      <a href="https://github.com/quirq-ai/wiki/tree/main/_sizes">
        Raw daily snapshots (JSONL).
      </a>
    </p>
  </div>
  {latest && (
    <div class="directory-summary sizes-summary">
      <span>
        <strong>{latest.totals.repos.toLocaleString('en-GB')}</strong>{' '}
        repositories
      </span>
      <span>
        <strong>{latest.totals.files.toLocaleString('en-GB')}</strong> files
        {filesChange !== null ? ` (${signed(filesChange, number)})` : ''}
      </span>
      <span>
        <strong>{formatBytes(latest.totals.bytes)}</strong> in total
        {bytesChange !== null ? ` (${signed(bytesChange, formatBytes)})` : ''}
      </span>
      <span>
        <strong>{bytes(latest.totals.githubBytes)}</strong> on GitHub
      </span>
    </div>
  )}
  {latest && !latest.totals.complete && (
    <p class="sizes-incomplete">
      Some repositories could not be measured in full, so the totals are a lower
      bound. They are marked in the table.
    </p>
  )}
  <h2 class="section-title" id="by-repository">
    By repository
  </h2>
  {rows.length ? (
    <div class="table-scroll">
      <table class="repository-table sizes-table">
        <caption class="visually-hidden">
          Files and size per repository, largest first
        </caption>
        <thead>
          <tr>
            <th scope="col">Repository</th>
            <th scope="col" class="numeric">
              Files
            </th>
            <th scope="col" class="numeric">
              Size
            </th>
            <th scope="col" class="numeric">
              Change
            </th>
            <th scope="col" class="numeric">
              On GitHub
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => {
            const delta = repoChange(row, before.get(row.repo));
            return (
              <tr id={`size-${row.repo}`}>
                <td>
                  <a
                    class="repo-table-name"
                    href={
                      pages.get(row.repo) ??
                      `https://github.com/${wiki.org}/${row.repo}`
                    }
                  >
                    {row.repo}
                  </a>
                  {row.failed && (
                    <span class="sizes-flag">could not be measured</span>
                  )}
                  {row.truncated && (
                    <span class="sizes-flag">partly measured</span>
                  )}
                </td>
                <td class="numeric">{number(row.files)}</td>
                <td class="numeric">{bytes(row.bytes)}</td>
                <td class="numeric">{signed(delta, formatBytes)}</td>
                <td class="numeric">{bytes(row.githubBytes)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  ) : (
    <p>No repository has been measured yet.</p>
  )}
  <h2 class="section-title" id="history">
    History
  </h2>
  {history.length ? (
    <div class="table-scroll">
      <table class="repository-table sizes-table">
        <caption class="visually-hidden">
          Organization totals per day for the last 90 days, newest first
        </caption>
        <thead>
          <tr>
            <th scope="col">Date (UTC)</th>
            <th scope="col" class="numeric">
              <abbr title="Repositories">Repos</abbr>
            </th>
            <th scope="col" class="numeric">
              Files
            </th>
            <th scope="col" class="numeric">
              Size
            </th>
            <th scope="col" class="numeric">
              Change
            </th>
            <th scope="col" class="numeric">
              On GitHub
            </th>
          </tr>
        </thead>
        <tbody>
          {history.map(({ snapshot, change }) => (
            <tr>
              <td>
                {snapshot.takenAt.slice(0, 10)}
                {!snapshot.totals.complete && (
                  <span class="sizes-flag">incomplete</span>
                )}
              </td>
              <td class="numeric">
                {snapshot.totals.repos.toLocaleString('en-GB')}
              </td>
              <td class="numeric">
                {snapshot.totals.files.toLocaleString('en-GB')}
              </td>
              <td class="numeric">{formatBytes(snapshot.totals.bytes)}</td>
              <td class="numeric">{signed(change, formatBytes)}</td>
              <td class="numeric">{bytes(snapshot.totals.githubBytes)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p>The history starts with the first daily measurement.</p>
  )}
</WikiLayout>
