{
  "name": "quirq-wiki-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "tsx --test tests/content.test.ts tests/article.test.ts tests/rich-markdown.test.ts tests/activity.test.ts tests/sizes.test.ts",
    "test:site": "node --test tests/site.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests/browser tests/*.test.ts tests/site.test.mjs astro.config.mjs playwright.config.ts",
    "format:check": "prettier --check src tests/browser tests/*.test.ts tests/site.test.mjs astro.config.mjs playwright.config.ts"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "github-slugger": "^2.0.0",
    "mermaid": "^12.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/unist": "^3.0.3",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
